---
/* Casco definitivo 3DE: header sticky + footer completo, mesma linguagem da vitrine. */
interface Props {title?: string;}
const {title = '3d-Everyday'} = Astro.props;
import '../styles.css';
import { sessionUid } from '../lib/auth';
import { balanceOf } from '../lib/credits';
import { listCategories } from '../lib/facets';
const uid = sessionUid(Astro.cookies.get('session3de')?.value, import.meta.env.SESSION_SECRET ?? '');
let saldo: number | null = null;
if (uid) { try { saldo = await balanceOf(uid); } catch { saldo = null; } }
let navCats: Awaited<ReturnType<typeof listCategories>> = [];
try { navCats = (await listCategories()).slice(0, 10); } catch { navCats = []; }
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="pt-BR" class="bg-stone-50 text-stone-900">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="theme-color" content="#0f1b2d"><link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><meta property="og:image" content="https://3de.focol.ai/icon-512.png"><meta name="twitter:card" content="summary"><title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-screen">
<header class="sticky top-0 z-50 border-b border-stone-200 bg-white">
<nav aria-label="Navegação do site" class="mx-auto flex min-h-20 max-w-6xl flex-row flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2">
<a href="/" class="flex items-center gap-2" aria-label="3d-Everyday — início">
<img src="/logo.png" alt="3d-Everyday" width="360" height="146" class="h-12 w-auto" loading="eager" fetchpriority="high" decoding="async">
</a>
<form action="/busca" method="get" class="hidden min-w-0 flex-1 sm:flex" role="search">
<input type="search" name="q" placeholder="Buscar peças..." aria-label="Buscar peças" class="h-10 w-full rounded-full border border-stone-200 bg-stone-50 px-4 text-sm"><button type="submit" class="sr-only">Buscar</button>
</form>
<div class="flex flex-1 items-center justify-end gap-2">
{uid && saldo !== null ? <a href="/conta" class="rounded-full bg-brand-600 px-4 py-2 font-mono text-sm font-bold text-white transition hover:bg-brand-700" title="Seu saldo — ver extrato">{saldo} créditos</a> : null}
{uid ? <><a href="/conta" aria-current={path === '/conta' ? 'page' : undefined} class="px-3 py-2 text-sm font-semibold uppercase hover:text-stone-600">Minha conta</a><a href="/loja" aria-current={path.startsWith('/loja') ? 'page' : undefined} class="px-3 py-2 text-sm font-semibold uppercase hover:text-stone-600">Loja</a><form method="post" action="/api/logout" style="display:inline"><button type="submit" class="cursor-pointer px-3 py-2 text-sm font-semibold uppercase hover:text-stone-600">Sair</button></form></> : <><a href="/loja" aria-current={path.startsWith('/loja') ? 'page' : undefined} class="px-3 py-2 text-sm font-semibold uppercase hover:text-stone-600">Loja</a><a href="/login" aria-current={path === '/login' ? 'page' : undefined} class="px-3 py-2 text-sm font-semibold uppercase hover:text-stone-600">Entrar</a></>}
</div>
{navCats.length ? <div class="hidden w-full overflow-x-auto border-t border-stone-100 md:block"><ul class="flex w-max gap-4 py-1.5 text-sm">{navCats.map((c) => (<li><a href={`/categoria/${c.slug}`} class="whitespace-nowrap text-stone-600 hover:text-brand-600 hover:underline">{c.name}</a></li>))}</ul></div> : null}
</nav>
</header>
<slot />
<footer class="mt-24 border-t border-stone-200 bg-white">
<div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm sm:grid-cols-3">
<div>
<p class="flex items-center gap-2"><img src="/logo.png" alt="3d-Everyday" width="360" height="146" class="h-8 w-auto" loading="lazy" decoding="async"></p>
<p class="mt-2 text-stone-600">Modelos fornecidos pela comunidade maker e selecionados pela curadoria 3d-Everyday.</p>
</div>
<div>
<p class="text-xs font-bold uppercase tracking-widest text-stone-500">Explorar</p>
<ul class="mt-2 flex flex-col gap-1.5">
<li><a href="/busca" class="hover:text-brand-600 hover:underline">Buscar peças</a></li><li><a href="/loja" class="hover:text-brand-600 hover:underline">Loja</a></li>
{navCats.slice(0, 5).map((c) => (<li><a href={`/categoria/${c.slug}`} class="hover:text-brand-600 hover:underline">{c.name}</a></li>))}
</ul>
</div>
<div>
<p class="text-xs font-bold uppercase tracking-widest text-stone-500">Conta</p>
<ul class="mt-2 flex flex-col gap-1.5">
{uid ? <><li><a href="/conta" class="hover:text-brand-600 hover:underline">Minha conta e extrato</a></li></> : <li><a href="/login" aria-current={path === '/login' ? 'page' : undefined} class="hover:text-brand-600 hover:underline">Entrar</a></li>}
<li><a href="/#como-funciona" class="hover:text-brand-600 hover:underline">Como funcionam os créditos</a></li>
</ul>
</div>
</div>
<div class="border-t border-stone-100"><p class="mx-auto max-w-6xl px-4 py-4 text-[13px] text-stone-600">3d-Everyday — cada download debita créditos da carteira do seu plano.</p></div>
</footer>
</body>
</html>
