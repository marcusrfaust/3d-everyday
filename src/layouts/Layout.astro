---
// Casco definitivo 3DE: header + footer no padrão vitrine (hero e seções nas páginas).
interface Props {title?: string;}
const {title = '3d-Everyday'} = Astro.props;
import '../styles.css';
const logado = !!Astro.cookies.get('session3de')?.value;
---
<!DOCTYPE html>
<html lang="pt-BR" class="bg-white text-neutral-900">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{title}</title></head>
<body class="min-h-screen">
<header class="border-b border-neutral-200 bg-white">
<nav aria-label="Navegação do site" class="mx-auto flex min-h-20 max-w-6xl flex-row items-center gap-4 px-4 py-2">
<div class="flex-1">
<a href="/" class="block w-fit p-2 text-lg font-extrabold tracking-tight">3d-Everyday</a>
</div>
<div class="flex flex-1 items-center justify-end gap-2">
<a href="/busca" class="px-3 py-2 text-sm font-semibold uppercase hover:text-neutral-600">Buscar</a>
{logado ? <><a href="/conta" class="px-3 py-2 text-sm font-semibold uppercase hover:text-neutral-600">Minha conta</a><form method="post" action="/api/logout" style="display:inline"><button type="submit" class="px-3 py-2 text-sm font-semibold uppercase hover:text-neutral-600">Sair</button></form></> : <a href="/login" class="px-3 py-2 text-sm font-semibold uppercase hover:text-neutral-600">Entrar</a>}
</div>
</nav>
</header>
<slot />
<footer class="mt-24 border-t border-neutral-200">
<div class="mx-auto max-w-6xl px-4 py-8 text-sm text-neutral-600">
<p class="font-semibold text-neutral-900">3d-Everyday — acervo 3D por créditos do plano Dash 3D.</p>
<p>Catálogo em curadoria. Preços em créditos; downloads debitados da carteira do plano.</p>
</div>
</footer>
</body>
</html>
