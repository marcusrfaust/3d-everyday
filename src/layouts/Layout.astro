---
// Casco definitivo 3DE — nav + conta + footer. Sem framework reativo na fase atual.
interface Props {title?: string;}
const {title = '3d-Everyday'} = Astro.props;
const uid = Astro.cookies.get('session3de')?.value;
const logado = !!uid;
---
<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{title}</title>
<style>
:root{color-scheme:light dark}
body{font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;margin:0 auto;max-width:1080px;padding:0 1rem;line-height:1.45}
header nav{display:flex;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid #ccc}
header nav a:first-child{font-weight:700;font-size:1.2rem}
header nav .sp{flex:1}
main{padding:1rem 0}
.grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1rem}
.grid li{border:1px solid #ddd;border-radius:8px;padding:.5rem}
.grid img{width:100%;height:160px;object-fit:cover;border-radius:4px;background:#f0f0f0}
.preco{font-weight:700}
footer{border-top:1px solid #ccc;margin-top:2rem;padding:1rem 0;color:#666;font-size:.9rem}
</style>
</head>
<body>
<header><nav><a href="/">3d-Everyday</a><a href="/busca">Buscar</a><span class="sp"></span>{logado ? <><a href="/conta">Minha conta</a><form method="post" action="/api/logout" style="display:inline"><button type="submit">Sair</button></form></> : <a href="/login">Entrar</a>}</nav></header>
<main><slot /></main>
<footer><p>3d-Everyday — acervo 3D por créditos do plano Dash 3D.</p></footer>
</body>
</html>
