---
// Casco definitivo 3DE: header + footer no padrão vitrine (hero e seções nas páginas).
interface Props {title?: string;}
const {title = '3d-Everyday'} = Astro.props;
import '../styles.css';
import { sessionUid } from '../lib/auth';
import { balanceOf } from '../lib/credits';
import { listCategories } from '../lib/facets';
const uid = sessionUid(Astro.cookies.get('session3de')?.value, import.meta.env.SESSION_SECRET ?? '');
let saldo: number | null = null;
if (uid) { try { saldo = await balanceOf(uid); } catch { saldo = null; } }
let navCats: Awaited<ReturnType<typeof listCategories>> = [];
try { navCats = (await listCategories()).slice(0, 10); } catch { navCats = []; }
---
<!DOCTYPE html>
<html lang="pt-BR" class="bg-white text-neutral-900">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{title}</title></head>
<body class="min-h-screen">
<header class="sticky top-0 z-50 border-b border-neutral-200 bg-white">
<nav aria-label="Navegação do site" class="mx-auto flex min-h-20 max-w-6xl flex-row flex-wrap items-center gap-x-4 gap-y-1 px-4 py-2">
<div class="flex-1">
<a href="/" class="block w-fit p-2 text-lg font-extrabold tracking-tight">3d-Everyday</a>
</div>
<form action="/busca" method="get" class="hidden min-w-0 flex-1 sm:flex">
<input type="search" name="q" placeholder="Buscar peças..." aria-label="Buscar peças" class="w-full border border-neutral-300 px-3 py-2">
</form>
<div class="flex flex-1 items-center justify-end gap-2">
{uid && saldo !== null ? <a href="/conta" class="border border-neutral-900 px-3 py-2 text-sm font-bold uppercase" title="Seu saldo — ver extrato">{saldo} créditos</a> : null}
{uid ? <><a href="/conta" class="px-3 py-2 text-sm font-semibold uppercase hover:text-neutral-600">Minha conta</a><form method="post" action="/api/logout" style="display:inline"><button type="submit" class="px-3 py-2 text-sm font-semibold uppercase hover:text-neutral-600">Sair</button></form></> : <a href="/login" class="px-3 py-2 text-sm font-semibold uppercase hover:text-neutral-600">Entrar</a>}
</div>
{navCats.length ? <div class="hidden w-full overflow-x-auto border-t border-neutral-100 md:block"><ul class="flex w-max gap-4 py-1 text-sm">{navCats.map((c) => (<li><a href={`/categoria/${c.slug}`} class="whitespace-nowrap opacity-70 hover:opacity-100 hover:underline">{c.name}</a></li>))}</ul></div> : null}
</nav>
</header>
<slot />
<footer class="mt-24 border-t border-neutral-200">
<div class="mx-auto max-w-6xl px-4 py-8 text-sm text-neutral-600">
<p class="font-semibold text-neutral-900">3d-Everyday — acervo 3D por créditos do plano Dash 3D.</p>
<p>Catálogo em curadoria. Preços em créditos; downloads debitados da carteira do plano.</p>
</div>
</footer>
</body>
</html>
