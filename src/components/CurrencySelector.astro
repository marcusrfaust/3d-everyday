---
// Seletor de moeda/região da loja (USD/EUR/BRL). POST recria o cart na região
// da moeda escolhida; `next` devolve o visitante à página atual.
const { current = 'usd', next = '/loja' } = Astro.props;
const opts: Array<[string, string]> = [['usd', 'USD — US$'], ['eur', 'EUR — €'], ['brl', 'BRL — R$']];
---
<form method="post" action="/api/cart/currency" class="flex items-center gap-2 text-sm">
<input type="hidden" name="next" value={next} />
<label class="font-semibold text-stone-600">Moeda
<select name="currency" class="ml-2 rounded-md border border-stone-300 bg-white px-2 py-1">
{opts.map(([v, label]) => <option value={v} selected={v === current}>{label}</option>)}
</select>
</label>
<button type="submit" class="cursor-pointer rounded-md border border-stone-300 px-2 py-1 text-sm hover:border-ember-700 hover:text-ember-700">OK</button>
</form>
