---
import Layout from '../layouts/Layout.astro';
import { searchItems, listCategories, listTags } from '../lib/facets';
export const prerender = false;
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const category = (Astro.url.searchParams.get('categoria') ?? '').trim();
const tag = (Astro.url.searchParams.get('tag') ?? '').trim();
let items: Awaited<ReturnType<typeof searchItems>> = [];
let erro: string | null = null;
let cats: Awaited<ReturnType<typeof listCategories>> = [];
let tags: Awaited<ReturnType<typeof listTags>> = [];
try { [items, cats, tags] = await Promise.all([searchItems({q, category, tag}), listCategories(), listTags()]); }
catch (e) { erro = e instanceof Error ? e.message : 'falha na busca'; }
---
<Layout title="Buscar — 3d-Everyday">
<h1>Buscar peças</h1>
<form method="get" action="/busca">
<input type="search" name="q" value={q} placeholder="nome da peça">
<button type="submit">Buscar</button>
</form>
<h2>Categorias</h2>
<ul>{cats.map((c) => (<li><a href={`/busca?categoria=${c.slug}`}>{c.name} ({c.count})</a></li>))}</ul>
<h2>Tags</h2>
<ul>{tags.map((t) => (<li><a href={`/busca?tag=${t.slug}`}>{t.name} ({t.count})</a></li>))}</ul>
{erro ? <p>Busca indisponível ({erro}).</p> : <>
<p>{items.length} peças.</p>
<ul>
{items.map((it) => (
<li>
{it.photoId != null ? <a href={`/modelo/${it.id}`}><img src={`/api/thumb/${it.photoId}`} alt="" loading="lazy" width="160"></a> : null}
<a href={`/modelo/${it.id}`}>{it.name}</a> — {it.price} créditos
{it.categoryName ? <span> ({it.categoryName})</span> : null}
</li>
))}
</ul>
</>}
</Layout>
