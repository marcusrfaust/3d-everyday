---
import Layout from '../layouts/Layout.astro';
import ModelCard from '../components/ModelCard.astro';
import { searchItems, listCategories, listTags } from '../lib/facets';
import { groupFacets } from '../lib/taggroups';
export const prerender = false;
const q = (Astro.url.searchParams.get('q') ?? '').trim();
const category = (Astro.url.searchParams.get('categoria') ?? '').trim();
const tag = (Astro.url.searchParams.get('tag') ?? '').trim();
let items: Awaited<ReturnType<typeof searchItems>> = [];
let erro: string | null = null;
let cats: Awaited<ReturnType<typeof listCategories>> = [];
let tags: Awaited<ReturnType<typeof listTags>> = [];
try { [items, cats, tags] = await Promise.all([searchItems({q, category, tag}), listCategories(), listTags()]); }
catch (e) { erro = e instanceof Error ? e.message : 'falha na busca'; }
---
<Layout title="Buscar — 3d-Everyday">
<main class="mx-auto mt-8 flex w-full max-w-6xl flex-wrap gap-4 px-4">
<aside class="flex w-64 flex-col gap-6 py-4">
<form method="get" action="/busca">
<input id="busca-q" type="search" name="q" value={q} placeholder="nome da peça" class="w-full border border-neutral-300 px-3 py-2">
<button type="submit" class="mt-2 flex h-12 w-full items-center justify-center bg-neutral-900 px-4 text-sm font-semibold uppercase text-white transition hover:bg-neutral-600">Buscar</button>
</form>
<div>
<h2 class="text-lg font-bold">Categorias</h2>
<ul class="mt-2 flex flex-col gap-1 text-sm">
{cats.map((c) => (<li><a href={`/busca?categoria=${c.slug}`} class:list={[category === c.slug && 'font-bold underline']}>{c.name} ({c.count})</a></li>))}
</ul>
</div>
<div>
<h2 class="text-lg font-bold">Tags</h2>
{groupFacets(tags).map((g) => (
<div class="mt-3 border-t border-neutral-100 pt-2">
<p class="text-xs font-bold uppercase text-neutral-500">{g.label}</p>
<ul class="mt-1 flex flex-col gap-1.5 text-sm">
{g.tags.map((t) => (<li><a href={`/busca?tag=${t.full}`} class:list={[tag === t.full && 'font-bold underline']}>{t.short} ({t.count})</a></li>))}
</ul>
</div>
))}
</div>
</aside>
<div class="min-w-0 flex-1">
<h1 class="text-2xl font-bold">{q || category || tag ? 'Resultados' : 'Todas as peças'}</h1>
{erro ? <p>Busca indisponível ({erro}).</p> : <>
<p class="mt-1 text-sm text-neutral-600">{items.length} peças.</p>
<div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
{items.map((it, idx) => (<ModelCard item={it} eager={idx === 0} />))}
</div>
</>}
</div>
</main>
</Layout>
