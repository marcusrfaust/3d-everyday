---
import Layout from '../../layouts/Layout.astro';
import ModelCard from '../../components/ModelCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { d1query } from '../../lib/d1';
import { priceForItem } from '../../lib/credits';
import { searchItems } from '../../lib/facets';
import { displayName } from '../../lib/catalog';
import { groupNames } from '../../lib/taggroups';
import { rotuloCategoria } from '../../lib/rotulos';
export const prerender = false;
const rawId = Astro.params.itemId;
const itemId = Number(rawId);
if (!Number.isInteger(itemId)) return new Response('peça inválida', {status: 400});
const rows = await d1query(
  `SELECT i.id AS id, i.name AS name, i.description AS description, c.slug AS category, c.name AS category_name,
    (SELECT f.id FROM files f WHERE f.item_id = i.id AND f.kind = 'photo' AND (f.local_path IS NOT NULL AND f.local_path <> '' OR f.drive_url LIKE 'https://drive.google.com/%') ORDER BY f.id DESC LIMIT 1) AS photoId,
    (SELECT f2.file_name FROM files f2 WHERE f2.item_id = i.id AND f2.kind = 'document' ORDER BY f2.id ASC LIMIT 1) AS fileName
   FROM items i LEFT JOIN categories c ON c.id = i.category_id
   WHERE i.id = ? AND i.status IN ('reposted','captured') AND i.is_adult = 0 LIMIT 1`, [itemId]);
if (!rows.length) return new Response('peça não encontrada', {status: 404});
const item = rows[0];
const tagRows = await d1query(`SELECT tag FROM item_tags WHERE item_id = ? ORDER BY tag ASC LIMIT 20`, [itemId]);
const price = await priceForItem(itemId);
let rel: Awaited<ReturnType<typeof searchItems>> = [];
try { rel = (await searchItems({category: item.category == null ? undefined : String(item.category), limit: 5})).filter((r) => r.id !== itemId).slice(0, 4); } catch { rel = []; }
const nome = displayName(String(item.name ?? ''), item.fileName == null ? null : String(item.fileName));
---
<Layout title={`${nome} — 3d-Everyday`}>
<main class="mx-auto mt-8 grid w-full max-w-[1200px] grid-cols-1 gap-8 px-4 lg:mx-0 lg:max-w-none lg:grid-cols-[1fr_32rem] lg:gap-16 xl:mx-auto">
<div>
<div class="relative flex aspect-square items-center justify-center overflow-hidden rounded-xl border border-stone-200 bg-stone-100">
{item.photoId != null ? <img src={`/api/thumb/${item.photoId}`} alt={nome} class="h-full w-full object-cover" /> : <span class="px-4 text-center text-sm text-stone-500">Sem foto no momento — imagem em curadoria.</span>}
</div>
</div>
<div class="flex flex-col gap-4">
<p class="text-sm text-stone-500"><a href="/" class="hover:text-brand-600 hover:underline">Início</a> / {item.category_name ? <><a href={`/categoria/${item.category}`} class="hover:text-brand-600 hover:underline">{rotuloCategoria(item.category, item.category_name)}</a> / </> : null}{nome}</p>
<h1 class="font-display text-3xl font-extrabold tracking-tight">{nome}</h1>
<p class="font-mono text-2xl font-bold text-brand-700">{price} créditos</p>
{tagRows.length ? <div class="flex flex-col gap-2 rounded-xl border border-stone-200 bg-white p-4">{groupNames(tagRows.map((r) => String(r.tag))).map((g) => (
<div>
<p class="text-xs font-bold uppercase tracking-widest text-stone-500">{g.label}</p>
<div class="mt-1 flex flex-wrap gap-2">{g.tags.map((t) => (<a href={`/busca?tag=${encodeURIComponent(t.full)}`} class="rounded-md border border-stone-200 px-2 py-1 text-xs font-semibold uppercase hover:border-brand-600 hover:text-brand-600">{t.short}</a>))}</div>
</div>
))}</div> : null}
{item.description ? <p class="text-stone-700">{String(item.description)}</p> : null}
{item.fileName ? <p class="text-xs text-stone-500">Arquivo: {String(item.fileName)}</p> : null}
<form method="post" action={`/api/download/${itemId}`}>
<button type="submit" class="flex h-12 w-full cursor-pointer items-center justify-center gap-3 bg-brand-600 px-4 text-sm font-semibold uppercase text-white transition hover:bg-brand-700">Baixar — {price} créditos</button>
</form>
<p class="text-sm text-stone-500">O download será debitado da carteira do seu plano. Sem créditos suficientes, fale com o suporte para atualizar seu plano.</p>
</div>
</main>
{rel.length ? <section class="mx-auto mt-16 w-full max-w-6xl px-4" aria-label="Relacionadas"><SectionHeader eyebrow="Continue explorando" title="Você também pode gostar" /><div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{rel.map((r) => (<ModelCard item={r} />))}</div></section> : null}
</Layout>
