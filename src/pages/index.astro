---
import Layout from '../layouts/Layout.astro';
import { listRecent, DEV_SAMPLE_LIMIT } from '../lib/catalog';
let items: Awaited<ReturnType<typeof listRecent>> = [];
let erro: string | null = null;
try { items = await listRecent(24); }
catch (e) { erro = e instanceof Error ? e.message : 'falha ao carregar catálogo'; }
---
<Layout title="3d-Everyday — acervo 3D">
<h1>Peças recentes</h1>
{erro ? <p>Catálogo indisponível no momento ({erro}). Tente mais tarde.</p> : <>
<p>Amostra de desenvolvimento — {items.length} peças (teto {DEV_SAMPLE_LIMIT}). Base atual é temporária; a base nova entra via .env sem mudar código.</p>
<ul>
{items.map((it) => (
<li><a href={`/api/download/${it.id}`}>{it.name}</a>{it.category ? <span> — {it.category}</span> : null}</li>
))}
</ul>
</>}
</Layout>
