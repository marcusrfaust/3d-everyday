---
// Vitrine 3DE: hero + carrossel em destaque + grade por categoria. Material real.
import Layout from '../layouts/Layout.astro';
import SpotlightCarousel from '../components/SpotlightCarousel.astro';
import CategorySection from '../components/CategorySection.astro';
---
<Layout title="3d-Everyday — acervo 3D">
<header class="relative flex h-96 max-h-dvh flex-col justify-end gap-4 bg-black py-8 text-white md:h-[512px] md:gap-8">
<div class="mx-auto w-full max-w-6xl px-4">
<h1 class="max-w-sm text-4xl font-extrabold drop-shadow-md md:text-5xl md:leading-[50px]">Hora de imprimir, Maker.</h1>
<p class="mt-2 max-w-md text-lg">Milhares de peças curadas, fotos reais e downloads por créditos do seu plano Dash 3D.</p>
<div class="mt-4"><a href="/busca" class="inline-flex h-12 items-center bg-white px-4 font-bold text-neutral-900 transition hover:bg-neutral-200 md:text-lg">Explorar peças</a></div>
</div>
</header>
<main class="mx-auto mt-16 flex max-w-6xl flex-col gap-y-16 px-4">
<SpotlightCarousel />
<CategorySection />
<p class="text-sm text-neutral-500">Amostra de desenvolvimento. A base atual é temporária; a base nova entra sem mudar código.</p>
</main>
</Layout>
