---
import Layout from '../../layouts/Layout.astro';
import ModelCard from '../../components/ModelCard.astro';
import { searchItems, listCategories } from '../../lib/facets';
export const prerender = false;
const slug = Astro.params.slug ?? '';
let items: Awaited<ReturnType<typeof searchItems>> = [];
let erro: string | null = null;
let cats: Awaited<ReturnType<typeof listCategories>> = [];
try { [items, cats] = await Promise.all([searchItems({category: slug}), listCategories()]); }
catch (e) { erro = e instanceof Error ? e.message : 'falha ao carregar categoria'; }
const atual = cats.find((c) => c.slug === slug);
---
<Layout title={`${atual?.name ?? 'Categoria'} — 3d-Everyday`}>
<main class="mx-auto mt-8 flex w-full max-w-6xl flex-wrap gap-4 px-4">
<aside class="flex w-64 flex-col gap-4 py-4">
<h2 class="text-lg font-bold">Categorias</h2>
<ul class="flex flex-col gap-1 text-sm">
{cats.map((c) => (<li><a href={`/categoria/${c.slug}`} class:list={[c.slug === slug && 'font-bold underline']}>{c.name} ({c.count})</a></li>))}
</ul>
</aside>
<div class="min-w-0 flex-1">
<h1 class="text-2xl font-bold">{atual?.name ?? 'Categoria'}</h1>
{erro ? <p>Categoria indisponível ({erro}).</p> : <>
<p class="mt-1 text-sm text-neutral-600">{items.length} peças.</p>
<div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
{items.map((it, idx) => (<ModelCard item={it} eager={idx === 0} />))}
</div>
</>}
</div>
</main>
</Layout>
