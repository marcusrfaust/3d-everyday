---
import Layout from '../layouts/Layout.astro';
const erro = Astro.url.searchParams.get('error') === '1';
---
<Layout title="Entrar — 3d-Everyday">
<main class="mx-auto mt-16 w-full max-w-md px-4">
<h1 class="text-2xl font-bold">Entrar</h1>
{erro ? <p class="mt-2 text-sm text-red-700">E-mail ou senha inválidos.</p> : null}
<form method="post" action="/api/login" class="mt-4 flex flex-col gap-3">
<label class="flex flex-col gap-1 text-sm font-medium">E-mail<input type="email" name="email" required autocomplete="email" class="border border-neutral-300 px-3 py-2"></label>
<label class="flex flex-col gap-1 text-sm font-medium">Senha<input type="password" name="password" required autocomplete="current-password" class="border border-neutral-300 px-3 py-2"></label>
<button type="submit" class="flex h-12 items-center justify-center bg-neutral-900 px-4 text-sm font-semibold uppercase text-white transition hover:bg-neutral-600">Entrar</button>
</form>
</main>
</Layout>
