---
import Layout from '../layouts/Layout.astro';
const erro = Astro.url.searchParams.get('error') === '1';
---
<Layout title="Entrar — 3d-Everyday">
<main class="mx-auto mt-16 w-full max-w-md px-4">
<div class="rounded-xl border border-stone-200 bg-white p-6">
<p class="text-xs font-bold uppercase tracking-widest text-ember-700">Acesso</p>
<h1 class="mt-1 font-display text-2xl font-extrabold tracking-tight">Entrar</h1>
{erro ? <p class="mt-2 text-sm text-red-700" role="alert">E-mail ou senha inválidos.</p> : null}
<form method="post" action="/api/login" class="mt-4 flex flex-col gap-3">
<label class="flex flex-col gap-1 text-sm font-medium">E-mail<input type="email" name="email" required autocomplete="email" class="h-10 rounded-lg border border-stone-200 bg-stone-50 px-3"></label>
<label class="flex flex-col gap-1 text-sm font-medium">Senha<input type="password" name="password" required autocomplete="current-password" class="h-10 rounded-lg border border-stone-200 bg-stone-50 px-3"></label>
<button type="submit" class="flex h-12 cursor-pointer items-center justify-center bg-ember-700 px-4 text-sm font-semibold uppercase text-white transition hover:bg-ember-800">Entrar</button>
</form>
</div>
</main>
</Layout>
