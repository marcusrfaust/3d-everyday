---
import Layout from '../../layouts/Layout.astro';
import CurrencySelector from '../../components/CurrencySelector.astro';
import { getProduct, priceInCurrency, formatMoney, normalizeCurrency, REGION_COOKIE } from '../../lib/medusa';
export const prerender = false;
const handle = String(Astro.params.handle ?? '');
const requested = Astro.url.searchParams.get('currency');
const chosen = normalizeCurrency(requested) ?? normalizeCurrency(Astro.cookies.get(REGION_COOKIE)?.value) ?? null;
if (requested && chosen) Astro.cookies.set(REGION_COOKIE, chosen, { path: '/', maxAge: 60 * 60 * 24 * 365, sameSite: 'lax' });
let product: Awaited<ReturnType<typeof getProduct>> = null;
let erro: string | null = null;
try { product = await getProduct(handle); } catch (e) { erro = e instanceof Error ? e.message : 'erro'; }
if (!erro && !product) return new Response('produto não encontrado', { status: 404 });
const found = product ? priceInCurrency(product, chosen ?? undefined) : { price: null, exact: false };
const pr = found.price;
const exactPrice = chosen ? found.exact : true;
const variantId = exactPrice ? product?.variants?.[0]?.id ?? '' : '';
const current = chosen ?? pr?.currency_code ?? 'usd';
---
<Layout title={`${product?.title ?? 'Produto'} — Loja 3d-Everyday`}>
<main class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-8 px-4 py-8 md:grid-cols-2">
<div class="flex aspect-square items-center justify-center overflow-hidden rounded-xl border border-stone-200 bg-stone-100">
{product?.thumbnail ? <img src={product.thumbnail} alt={product.title} class="h-full w-full object-cover" /> : <span class="text-sm text-stone-500">Sem foto no momento.</span>}
</div>
<div class="flex flex-col gap-4">
<p class="text-sm text-stone-500"><a href="/" class="hover:underline">Início</a> / <a href="/loja" class="hover:underline">Loja</a> / {product?.title}</p>
<div class="flex items-center justify-end"><CurrencySelector current={current} next={`/loja/${handle}`} /></div>
{erro ? <p class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">Loja indisponível ({erro}).</p> : null}
<h1 class="font-display text-3xl font-extrabold tracking-tight">{product?.title}</h1>
<p class="font-mono text-2xl font-bold text-brand-700">{pr ? formatMoney(pr.amount, pr.currency_code) : 'preço sob consulta'}</p>
{pr && !exactPrice ? <p class="text-xs text-stone-500">Preço exibido em {pr.currency_code.toUpperCase()} — sem preço nesta moeda no momento.</p> : null}
{(product?.variants?.length ?? 0) > 1 ? <p class="text-sm text-stone-500">Variação: {product?.variants?.[0]?.title ?? 'única'} (+{(product?.variants?.length ?? 1) - 1} opções no checkout)</p> : null}
{variantId ? <form method="post" action="/api/cart/add">
<input type="hidden" name="variantId" value={variantId} />
<div class="flex items-center gap-3">
<label for="qty" class="text-sm font-semibold">Qtd</label><input id="qty" type="number" name="qty" value="1" min="1" max="99" class="ml-2 w-16 rounded-md border border-stone-300 px-2 py-2" />
<button type="submit" aria-label="Adicionar ao carrinho" class="flex h-12 flex-1 cursor-pointer items-center justify-center bg-brand-600 px-4 text-sm font-semibold uppercase text-white transition hover:bg-brand-700">Adicionar ao carrinho</button>
</div>
</form> : <p class="text-sm text-stone-500">{pr && !exactPrice ? 'Produto sem preço nesta moeda no momento — troque a moeda para comprar.' : 'Produto sem variação comprável no momento.'}</p>}
</div>
</main>
</Layout>
