---
import Layout from '../../layouts/Layout.astro';
import CurrencySelector from '../../components/CurrencySelector.astro';
import { getCart, formatMoney, cartCount, normalizeCurrency, REGION_COOKIE } from '../../lib/medusa';
export const prerender = false;
// ?currency= aqui só persiste a preferência (sem recriar o cart no GET);
// a troca com recriação acontece no seletor (POST /api/cart/currency).
const requested = Astro.url.searchParams.get('currency');
const chosen = normalizeCurrency(requested) ?? normalizeCurrency(Astro.cookies.get(REGION_COOKIE)?.value) ?? null;
if (requested && chosen) Astro.cookies.set(REGION_COOKIE, chosen, { path: '/', maxAge: 60 * 60 * 24 * 365, sameSite: 'lax' });
const cartId = Astro.cookies.get('medusa_cart')?.value;
const checkout = Astro.url.searchParams.get('checkout');
const erroMsg = Astro.url.searchParams.get('erro');
let cart: Awaited<ReturnType<typeof getCart>> = null;
if (cartId) { try { cart = await getCart(cartId); } catch { cart = null; } }
// Fonte da verdade do carrinho: moeda do cart; sem cart, a preferência.
const current = cart?.currency_code ?? chosen ?? 'usd';
---
<Layout title="Carrinho — Loja 3d-Everyday">
<main class="mx-auto w-full max-w-3xl px-4 py-8">
<div class="flex items-center justify-between gap-4">
<h1 class="font-display text-3xl font-extrabold tracking-tight">Carrinho</h1>
<CurrencySelector current={current} next="/loja/carrinho" />
</div>
{checkout === 'ok' ? <p class="mt-4 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-800">Pedido registrado. Acompanhe o pagamento pelo e-mail informado no checkout.</p> : null}
{erroMsg ? <p class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">Não foi possível concluir: {erroMsg}</p> : null}
{!cart || !cart.items.length ? <p class="mt-6 text-sm text-stone-500">Carrinho vazio. <a href="/loja" class="text-brand-600 hover:underline">Ver loja</a></p> : <>
<p class="mt-2 text-sm text-stone-500">{cartCount(cart)} {cartCount(cart) === 1 ? 'item' : 'itens'}</p>
<ul class="mt-4 flex flex-col gap-3">
{cart.items.map((i) => (
<li class="flex items-center gap-3 rounded-xl border border-stone-200 bg-white p-3">
{i.thumbnail ? <img src={i.thumbnail} alt={i.title} class="h-14 w-14 rounded-md object-cover" /> : <span class="flex h-14 w-14 items-center justify-center rounded-md bg-stone-100 text-xs text-stone-400">—</span>}
<div class="min-w-0 flex-1"><p class="truncate text-sm font-bold">{i.title}</p><p class="font-mono text-sm text-brand-700">{formatMoney(i.unit_price, cart.currency_code)}</p></div>
<form method="post" action="/api/cart/update" class="flex items-center gap-2">
<input type="hidden" name="lineId" value={i.id} />
<input type="number" name="qty" value={i.quantity} min="0" max="99" class="w-14 rounded-md border border-stone-300 px-2 py-1 text-sm" />
<button type="submit" class="cursor-pointer rounded-md border border-stone-300 px-2 py-1 text-sm hover:border-brand-600 hover:text-brand-600">OK</button>
</form>
</li>))}
</ul>
<div class="mt-6 flex items-center justify-between border-t border-stone-200 pt-4">
<p class="text-sm font-semibold uppercase text-stone-500">Total</p>
<p class="font-mono text-2xl font-bold text-brand-700">{formatMoney(cart.total, cart.currency_code)}</p>
</div>
<form method="post" action="/api/cart/checkout" class="mt-4">
<button type="submit" class="flex h-12 w-full cursor-pointer items-center justify-center bg-brand-600 px-4 text-sm font-semibold uppercase text-white transition hover:bg-brand-700">Finalizar pedido</button>
</form>
<p class="mt-2 text-xs text-stone-500">Pagamento via provedor configurado no Medusa. Sem provedor ativo, a conclusão retorna o motivo real.</p>
</>}
</main>
</Layout>
