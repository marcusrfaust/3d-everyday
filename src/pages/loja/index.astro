---
import Layout from '../../layouts/Layout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ModelCard from '../../components/ModelCard.astro';
import { searchItems } from '../../lib/facets';
export const prerender = false;
// Loja oficial = projetos STL/3MF do acervo, preço em créditos (decisão Marcus 04/11/26).
// O backend Medusa segue como checkout; a grade aqui lê o catálogo real —
// sem produto demo (t-shirt/shorts): nada é apagado do Medusa, só não é anunciado.
let items: Awaited<ReturnType<typeof searchItems>> = [];
let lojaErro: string | null = null;
try { items = await searchItems({page: 1, perPage: 24}); } catch (e) { lojaErro = e instanceof Error ? e.message : 'erro'; }
---
<Layout title="Loja — 3d-Everyday">
<main class="mx-auto w-full max-w-6xl px-4 py-8">
<SectionHeader eyebrow="Catálogo oficial" title="Loja" linkHref="/busca" linkLabel="Ver tudo →" />
<p class="mt-2 text-sm text-stone-500">Projetos STL e 3MF do acervo — preço em créditos do seu plano. O download debita da carteira na hora. Sem saldo? <a href="/loja/creditos" class="font-semibold text-brand-600 hover:underline">Comprar créditos avulsos</a>.</p>
{lojaErro ? <p class="mt-4 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800" role="alert">Loja indisponível no momento ({lojaErro}). Tente novamente em instantes.</p> : null}
{!lojaErro && !items.length ? <p class="mt-4 text-sm text-stone-500">Nenhum projeto publicado no momento.</p> : null}
<div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4">
{items.map((it) => (<ModelCard item={it} />))}
</div>
</main>
</Layout>
